# ----------------------------------------------------------------------------
# Family Calendar — environment variables
# Copy this file to `.env.local` for local development and fill in values.
# Never commit real secrets — `.env*` is gitignored.
# ----------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (added in F1/F2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron (keep-warm job in vercel.json)
# Required in production — the cron route returns 503 without it so the
# endpoint is never anonymously pingable. Vercel sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -hex 32
CRON_SECRET=

# Groq AI (added in F11)
GROQ_API_KEY=

# Web Push / VAPID (added in F10)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
